// VaultGuard — Prisma Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model Role {
  key         String   @id
  label       String
  priority    Int      @default(0)
  isProtected Boolean  @default(false)
  color       String?  @default("#64748b")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  folderPermissions FolderPermission[]
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  username        String     @unique
  passwordHash    String?
  firstName       String
  lastName        String
  role            String     @default("AUXILIAR")
  roleRef         Role       @relation(fields: [role], references: [key])
  status          UserStatus @default(PENDING)
  totpSecret      String?
  totpEnabled     Boolean    @default(false)
  totpPendingSecret String?
  // Último passo de 30s aceito: o mesmo código não pode ser reusado
  totpLastStep    Int?
  // Hashes bcrypt dos códigos de recuperação do 2FA ainda não usados
  totpRecoveryCodes String[]  @default([])
  // Política de senha: expiração, troca obrigatória e histórico para impedir reuso
  passwordChangedAt  DateTime  @default(now())
  mustChangePassword Boolean   @default(false)
  passwordHistory    String[]  @default([])
  // Incrementado para invalidar todos os JWTs emitidos (logout, troca de senha, etc.)
  tokenVersion    Int        @default(0)
  failedLoginAttempts Int    @default(0)
  lockedUntil     DateTime?
  apiToken        String?    @unique
  lastLogin       DateTime?
  avatar          String?
  encryptionSalt  String?
  // Par de chaves RSA-OAEP do usuário: pública em SPKI/base64, privada cifrada
  // no cliente (AES-GCM com chave derivada da senha). O servidor nunca vê a privada.
  publicKey           String?
  encryptedPrivateKey String?
  // AD / LDAP
  ldapDn          String?    @unique
  ldapGuid        String?    @unique
  authSource      String     @default("local")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  folderPermissions FolderPermission[]
  auditLogs         AuditLog[]
  apiTokens         ApiToken[]
  favorites         Favorite[]
  personalFolders   Folder[]   @relation("PersonalFolders")
  ownedTeams        Team[]     @relation("TeamOwner")
  teamMemberships   TeamMember[]

  @@index([email])
  @@index([username])
  @@index([ldapDn])
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
  folders Folder[]

  @@index([ownerId])
}

model TeamMember {
  id          String    @id @default(uuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING | ACTIVE | DECLINED
  invitedById String
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

model Folder {
  id           String   @id @default(uuid())
  name         String
  description  String?
  icon         String?  @default("folder")
  color        String?  @default("#6366f1")
  parentId     String?
  parent       Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children     Folder[] @relation("FolderTree")
  sortOrder    Int      @default(0)
  isPersonal   Boolean  @default(false)
  ownerId      String?
  owner        User?    @relation("PersonalFolders", fields: [ownerId], references: [id])
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  visibleToAll Boolean  @default(false)
  // true depois que alguém gerou a chave AES da pasta (só pode acontecer uma vez)
  keyInitialized Boolean @default(false)
  // Alguém perdeu acesso: a próxima pessoa com a chave gera uma nova
  needsKeyRotation Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  credentials Credential[]
  permissions FolderPermission[]
  keys        FolderKey[]

  @@index([parentId])
  @@index([ownerId])
  @@index([teamId])
}

model FolderPermission {
  id        String   @id @default(uuid())
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?
  roleRef   Role?    @relation(fields: [role], references: [key], onDelete: Cascade)
  canView   Boolean  @default(true)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  canShare  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([folderId, userId])
  @@unique([folderId, role])
  @@index([folderId])
  @@index([userId])
}

model Credential {
  id            String   @id @default(uuid())
  folderId      String
  folder        Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  title         String
  username      String?
  encryptedPass String
  url           String?
  notes         String?
  tags          String[] @default([])
  favicon       String?
  strength      Int?
  lastUsed      DateTime?
  expiresAt     DateTime?
  // "login" (usuário/senha de site) ou "certificate" (certificado digital A1:
  // arquivo .pfx em anexo + senha do certificado)
  kind          String   @default("login")
  // Chave AES própria da credencial, cifrada com a chave da pasta.
  // null = credencial legada (v0/v1), ainda não migrada.
  wrappedKey    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customFields  CredentialField[]
  attachments   Attachment[]

  @@index([folderId])
  @@index([url])
}

model CredentialField {
  id           String     @id @default(uuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  name         String
  value        String
  fieldType    String     @default("text")
  sortOrder    Int        @default(0)

  @@index([credentialId])
}

model Attachment {
  id           String     @id @default(uuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  data         String
  createdAt    DateTime   @default(now())

  @@index([credentialId])
}

model SystemSettings {
  id              String  @id @default("singleton")
  siteName        String  @default("VaultGuard")
  siteSubtitle    String  @default("Cofre de Senhas Corporativo")
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String  @default("#6366f1")
  accentColor     String  @default("#8b5cf6")
  bgColor         String  @default("#0f0f1a")
  surfaceColor    String  @default("#1a1a2e")
  themeMode       String  @default("dark")
  // Contato de suporte exibido no login e no menu (vazio = não exibe)
  supportEmail    String?
  defaultLanguage String  @default("pt-BR")
  allowSelfReg    Boolean @default(false)
  require2FA      Boolean @default(false)
  sessionTimeout  Int     @default(480)
  maxLoginAttempts Int    @default(5)
  passwordPolicy  Json?
  smtpConfig      Json?
  // LDAP / Active Directory config (criptografado em JSON)
  ldapEnabled     Boolean @default(false)
  ldapConfig      Json?
  updatedAt       DateTime @updatedAt
}

model ApiToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // SHA-256 (hex) do token — o valor bruto só é exibido uma vez na criação
  token     String   @unique
  tokenPrefix String?
  lastUsed  DateTime?
  expiresAt DateTime?
  scopes    String[] @default(["read"])
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String
  createdAt    DateTime @default(now())

  @@unique([userId, credentialId])
  @@index([userId])
}

model CredentialHistory {
  id            String   @id @default(uuid())
  credentialId  String
  encryptedPass String
  changedById   String?
  changedAt     DateTime @default(now())

  @@index([credentialId])
  @@index([changedAt])
}

model CredentialShare {
  id           String   @id @default(uuid())
  credentialId String
  sharedById   String
  sharedWithId String
  canEdit      Boolean  @default(false)
  expiresAt    DateTime?
  // Chave da credencial cifrada com a chave pública do destinatário
  wrappedKey   String?
  createdAt    DateTime @default(now())

  @@unique([credentialId, sharedWithId])
  @@index([credentialId])
  @@index([sharedWithId])
}

model AccessRequest {
  id        String   @id @default(uuid())
  userId    String
  folderId  String
  message   String?
  status    String   @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([folderId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceId   String?
  resourceType String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Chave AES de uma pasta, cifrada para um detentor: o id de um usuário
// (RSA-OAEP com a chave pública dele) ou "ORG" (chave da organização).
model FolderKey {
  id          String   @id @default(uuid())
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  holder      String
  wrappedKey  String
  grantedById String?
  createdAt   DateTime @default(now())

  @@unique([folderId, holder])
  @@index([holder])
}

// Par de chaves da organização. Recebe cópia das chaves de todas as pastas não
// pessoais para que qualquer administrador possa liberar acesso a novos membros.
model OrgKey {
  id        String   @id @default("singleton")
  publicKey String
  createdAt DateTime @default(now())
}

// Chave privada da organização cifrada para cada administrador
model OrgKeyGrant {
  id          String   @id @default(uuid())
  userId      String   @unique
  wrappedKey  String
  grantedById String?
  createdAt   DateTime @default(now())
}

// Dispositivos já vistos por usuário (alerta de acesso de dispositivo novo)
model UserDevice {
  id          String   @id @default(uuid())
  userId      String
  fingerprint String
  userAgent   String?
  ip          String?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId])
}
